{
    "scopeName": "gherkin.grammar",
    "reference": "https://macromates.com/manual/en/language_grammars",
    "patterns": [
        {
            "match": "^\\s*#.*",
            "name": "comment.line"
        },
        {
            "match": "^\\s*(\"\"\").*(\"\"\")",
            "name": "comment.line"
        },
        {
            "begin": "^\\s*(\"\"\")",
            "end": "^\\s*(\"\"\")",
            "name": "comment.line"
        },
        {
            "match": "^\\s*(@.*)",
            "captures": {
                "1": {
                    "name": "keyword.control"
                }
            }
        },
        {
            "match": "^\\s*(Feature|Background|Rule|Scenario|Scenario Outline|Scenario Template):(.*)",
            "captures": {
                "1": {
                    "name": "markup.bold"
                },
                "2": {
                    "name": "string"
                }
            }
        },
        {
            "match": "^\\s*(Given|When|Then|And|But)(?:\\:)?(.*)",
            "captures": {
                "1": {
                    "name": "keyword"
                },
                "2": {
                    "name": "variable"
                }
            }
        },
        {
            "match": "^\\s*(Examples?):(.*)",
            "captures": {
                "1": {
                    "name": "support.type"
                },
                "2": {
                    "name": "constant.numeric"
                }
            }
        },
        {
            "comment": "a table: the first row is its headings (behave's table.headings), the rest are data rows",
            "begin": "^\\s*(\\|.*)$",
            "beginCaptures": {
                "1": {
                    "patterns": [
                        {
                            "match": "\\|",
                            "name": "support.type"
                        },
                        {
                            "match": "[^|\\s](?:[^|]*[^|\\s])?",
                            "name": "markup.heading"
                        }
                    ]
                }
            },
            "while": "^(?=\\s*[|#])",
            "patterns": [
                {
                    "match": "^\\s*#.*",
                    "name": "comment.line"
                },
                {
                    "match": "\\|",
                    "name": "support.type"
                }
            ]
        }
    ]
}